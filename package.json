{
    "name": "vesktop",
    "version": "1.7.1",
    "private": true,
    "description": "Vesktop is a custom Discord desktop app",
    "keywords": [],
    "homepage": "https://github.com/Rhinomcd/voxland-desktop",
    "license": "GPL-3.0-or-later",
    "author": "Vendicated <vendicated@riseup.net>",
    "main": "dist/js/main.js",
    "scripts": {
        "build": "vpx scripts/build/build.mts",
        "build:dev": "vp run build --dev",
        "buildLibVesktop": "vp -C packages/libvesktop install && vp -C packages/libvesktop run build",
        "package": "vp run build && electron-builder",
        "package:dir": "vp run build && electron-builder --dir",
        "lint": "vp lint src scripts packages/discord-rpc",
        "lint:fix": "vp run lint --fix",
        "fmt": "vp fmt",
        "fmt:check": "vp fmt --check",
        "start": "vp run build && electron --enable-source-maps .",
        "start:dev": "vp run build:dev && electron --enable-source-maps .",
        "start:watch": "vp run build:dev && vpx scripts/startWatch.mts",
        "test": "vp run lint && vp run fmt:check && vp run testTypes && vp test",
        "testTypes": "tsc --noEmit",
        "watch": "vp run build --watch"
    },
    "dependencies": {
        "electron-updater": "6.6.2",
        "uiohook-napi": "^1.5.5"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.5"
    },
    "devDependencies": {
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@types/node": "^26.6.5",
        "@types/react": "19.2.9",
        "@vencord/types": "1.15.19",
        "discord-rpc": "workspace:*",
        "electron": "45.5.0",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "eslint-plugin-simple-header": "^1.2.2",
        "libvesktop": "link:packages/libvesktop",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.15",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "vite-plus": "catalog:"
    },
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
        "pnpm": ">=11"
    },
    "build": {
        "appId": "dev.vencord.vesktop",
        "productName": "Vesktop",
        "executableName": "vesktop",
        "files": [
            "!*",
            "!node_modules",
            "dist/js",
            "static",
            "package.json",
            "LICENSE"
        ],
        "protocols": {
            "name": "Discord",
            "schemes": [
                "discord"
            ]
        },
        "beforePack": "scripts/build/beforePack.mjs",
        "npmRebuild": false,
        "toolsets": {
            "appimage": "1.0.3"
        },
        "linux": {
            "icon": "build/icon.svg",
            "category": "Network",
            "maintainer": "vendicated+vesktop@riseup.net",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "Vesktop",
                    "GenericName": "Internet Messenger",
                    "Type": "Application",
                    "Categories": "Network;InstantMessaging;Chat;",
                    "Keywords": "discord;vencord;electron;chat;",
                    "MimeType": "x-scheme-handler/discord",
                    "StartupWMClass": "vesktop"
                }
            }
        },
        "mac": {
            "target": [
                {
                    "target": "default",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "This app needs access to the microphone",
                "NSCameraUsageDescription": "This app needs access to the camera",
                "com.apple.security.device.audio-input": true,
                "com.apple.security.device.camera": true
            },
            "requirements": "build/signing-requirements.txt",
            "notarize": true
        },
        "dmg": {
            "background": "build/background.tiff",
            "icon": "build/icon.icns",
            "iconSize": 105,
            "window": {
                "width": 512,
                "height": 340
            },
            "contents": [
                {
                    "x": 140,
                    "y": 160
                },
                {
                    "x": 372,
                    "y": 160,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "Rhinomcd",
            "repo": "voxland-desktop"
        },
        "rpm": {
            "fpm": [
                "--rpm-rpmbuild-define=_build_id_links none",
                "--rpm-rpmbuild-define=_rpmformat 4"
            ]
        },
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": false,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": false
        }
    }
}
